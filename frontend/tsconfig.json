{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "~/components/*": ["./components/*"]
    },
    "skipLibCheck": true
  },
  "extends": "expo/tsconfig.base"
}
